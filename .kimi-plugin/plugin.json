{
  "name": "x-harness",
  "version": "1.0.0",
  "description": "Обвязка разработки для агентов: реестры планов RM/PLAN/HF, git-процесс, гейты и хуки, роли субагентов. Хуки срабатывают только в проектах с установленной обвязкой.",
  "author": {
    "name": "Evgeny Romanov",
    "url": "https://github.com/cheusbeats"
  },
  "homepage": "https://github.com/cheusbeats/x-harness",
  "repository": "https://github.com/cheusbeats/x-harness",
  "license": "MIT",
  "keywords": [
    "planning",
    "hooks",
    "git-workflow",
    "quality-gate",
    "skills"
  ],
  "skills": "./skills/",
  "sessionStart": {
    "skill": "x-harness"
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "python3 \"$KIMI_PLUGIN_ROOT/adapters/agent-hook.py\" kimi SessionStart",
      "timeout": 30
    },
    {
      "event": "PreToolUse",
      "matcher": "Bash|Edit|Write|Read|MultiEdit|NotebookEdit|ApplyPatch|apply_patch|exec_command|shell_command|shell|functions.exec_command|functions.apply_patch",
      "command": "python3 \"$KIMI_PLUGIN_ROOT/adapters/agent-hook.py\" kimi PreToolUse",
      "timeout": 300
    }
  ],
  "interface": {
    "displayName": "X-Harness",
    "shortDescription": "Planning registries, git gates and hooks for coding agents",
    "developerName": "Evgeny Romanov",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://github.com/cheusbeats/x-harness"
  }
}
