#!/usr/bin/env bash
# pre-commit - авторитетная проверка коммита (SPEC п.5,7, §9):
#   1) planning-checks.py staged: E2/E18 (строгий слой) + E7/E8/E9 + owner-ok;
#   2) registry.sh check по STAGED-дереву planning/ (registry.sh читает файлы с диска,
#      а в коммит уйдёт индекс - выгружаем staged-версию);
#   3) обязательный GATE_FAST при STRICT=on.
# exit 1 = коммит заблокирован. Внутренняя ошибка хука - fail-open с сообщением.
cd "$(git rev-parse --show-toplevel)" || exit 0
command -v python3 >/dev/null 2>&1 || {
  echo "pre-commit: python3 не найден - проверки НЕ выполнены (fail-open)" >&2
  exit 0
}
branch="$(git symbolic-ref --short -q HEAD || echo HEAD)"
fail=0

if [ -f .claude/hooks/planning-checks.py ]; then
  python3 .claude/hooks/planning-checks.py staged "$branch"
  [ $? -eq 2 ] && fail=1
else
  echo "pre-commit: нет .claude/hooks/planning-checks.py - проверки плана пропущены (fail-open)" >&2
fi

if [ ! -f .claude/scripts/registry.sh ]; then
  echo "pre-commit: нет .claude/scripts/registry.sh - проверка реестров пропущена (fail-open)" >&2
else
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/planning"
  git ls-files -z -- planning | xargs -0 git checkout-index --prefix="$tmp/" -- 2>/dev/null
  export_rc=$?
  expected="$(git ls-files -- planning | wc -l | tr -d ' ')"
  got="$(find "$tmp/planning" -type f | wc -l | tr -d ' ')"
  if [ "$export_rc" -ne 0 ] || [ "$expected" -ne "$got" ]; then
    # пустой/неполный экспорт нельзя выдавать за «реестр чист»
    echo "pre-commit: внутренняя ошибка хука - выгрузка staged-дерева planning/ ($got из $expected файлов); проверка реестров НЕ выполнена" >&2
  else
    out="$(bash .claude/scripts/registry.sh check --registry all --root "$tmp" 2>&1)"
    rc=$?
    if [ "$rc" -eq 1 ] && ! printf '%s' "$out" | grep -q 'Traceback'; then
      printf '%s\n' "$out" >&2
      fail=1
    elif [ "$rc" -ne 0 ]; then
      # fail-open: баг самого registry.sh не должен парализовать владельца
      echo "pre-commit: внутренняя ошибка registry.sh (код $rc), проверка реестров пропущена" >&2
    fi
  fi
fi

# GATE_FAST обязателен при STRICT=on; при STRICT=off строгий слой отключён.
if [ -f .claude/scripts/planning-lib.sh ]; then
  # shellcheck source=../.claude/scripts/planning-lib.sh
  . .claude/scripts/planning-lib.sh
  planning_load_conf
  if planning_strict_on; then
    echo "pre-commit: GATE_FAST: ${GATE_FAST:-не задан}" >&2
    if ! bash .claude/scripts/quality-gate.sh --fast; then
      echo "pre-commit: GATE_FAST упал - коммит заблокирован (SPEC §9)." >&2
      fail=1
    fi
  fi
fi

[ "$fail" -eq 1 ] && echo "pre-commit: коммит заблокирован (SPEC п.5, §9). Обход - только владелец: git commit --no-verify." >&2
exit "$fail"
