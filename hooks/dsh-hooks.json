{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/adapters/agent-hook.py\" dsh SessionStart",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Read|MultiEdit|ApplyPatch|apply_patch|bash|edit|write|read|apply-patch|shell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/adapters/agent-hook.py\" dsh PreToolUse",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
